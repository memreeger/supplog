SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/supplog_db
DB_USERNAME=postgres
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_DAYS=30
REFRESH_TOKEN_ABSOLUTE_EXPIRATION_DAYS=90
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10
REFRESH_COOKIE_SECURE=false
TRUSTED_PROXY_HOPS=0

# Mail: log (mail gönderilmez, link loglanır) or brevo
MAIL_PROVIDER=log
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Supplog
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=3
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_TIME_ZONE=UTC
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SUPPORT_RATE_LIMIT_MAX_REQUESTS=120
SUPPORT_RATE_LIMIT_WINDOW_SECONDS=60
ROUTINE_EXECUTION_MISSED_INTERVAL_MS=60000
ROUTINE_EXECUTION_MISSED_INITIAL_DELAY_MS=60000

# Tests must use a separate database.
TEST_DB_URL=jdbc:postgresql://localhost:5432/supplog_test
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=change-me
RUN_DB_INTEGRATION_TESTS=false

# Restore drills only; must never point to production.
RESTORE_DB_URL=postgresql://localhost:5432/supplog_restore_check

ADMIN_SEED_ENABLED=false
ADMIN_SEED_USERNAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_TIME_ZONE=UTC
